{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "compaction": {
    "enabled": true
  },
  "collapseChangelog": false,
  "doubleEscapeAction": "tree",
  "images": {
    "autoResize": true
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "one-at-a-time",
  "packages": [
    {
      "source": "npm:pi-web-access",
      "extensions": [
        "+dist/index.js"
      ]
    },
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": [
        "-dist/extensions/agent-browser/index.js"
      ]
    },
    {
      "source": "npm:pi-agents-pool",
      "extensions": [
        "+extension/index.ts"
      ]
    },
    {
      "source": "npm:@mjakl/pi-subagent",
      "extensions": [
        "+index.ts"
      ]
    }
  ],
  "hideThinkingBlock": false,
  "followUpMode": "one-at-a-time",
  "httpIdleTimeoutMs": 120000,
  "treeFilterMode": "all",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "enabledModels": [
    "deepseek-v4-pro",
    "deepseek-flash"
  ],
  "extensions": [
    "+extensions/secret-scrubber.ts",
    "+extensions/cron.ts",
    "+extensions/git-commit.ts",
    "+extensions/observability/index.ts",
    "+extensions/pi-prompt-capture.ts",
    "+builtin:codemode",
    "+builtin:llama.cpp",
    "+builtin:mcp",
    "+builtin:tool-search"
  ],
  "skills": [
    "+skills/gog-workspace/SKILL.md",
    "+skills/partner-agent-export/SKILL.md",
    "+skills/pi-prompt-dump/SKILL.md",
    "+skills/skill-creator/SKILL.md",
    "+skills/video-finder/SKILL.md",
    "+skills/yt-download/SKILL.md"
  ],
  "prompts": [
    "+prompts/document.md",
    "+prompts/dump.md",
    "+prompts/explore-pi.md",
    "+prompts/readocs.md",
    "+prompts/short.md"
  ]
}