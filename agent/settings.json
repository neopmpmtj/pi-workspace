{
  "lastChangelogVersion": "1.0.2",
  "theme": "dark",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "compaction": {
    "enabled": true
  },
  "collapseChangelog": false,
  "doubleEscapeAction": "tree",
  "images": {
    "autoResize": true
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "one-at-a-time",
  "packages": [
    {
      "source": "npm:pi-web-access",
      "extensions": [
        "+dist/index.js"
      ]
    },
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": [
        "-dist/extensions/agent-browser/index.js"
      ]
    },
    {
      "source": "npm:pi-agents-pool",
      "extensions": [
        "+extension/index.ts"
      ]
    },
    {
      "source": "npm:@mjakl/pi-subagent",
      "extensions": [
        "+index.ts"
      ]
    }
  ],
  "hideThinkingBlock": false,
  "followUpMode": "one-at-a-time",
  "httpIdleTimeoutMs": 120000,
  "treeFilterMode": "all",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "enabledModels": [
    "deepseek-v4-pro",
    "deepseek-flash"
  ],
  "extensions": [
    "+extensions/git-commit.ts",
    "+extensions/observability/index.ts",
    "+extensions/pi-prompt-capture.ts",
    "+extensions/secret-scrubber.ts",
    "+extensions/cron.ts"
  ]
}