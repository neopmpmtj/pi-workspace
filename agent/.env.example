# credentials for the chief-of-staff agent.
#
# Copy to ~/.pi/agent/.env (the folder above the agent home; mode 600) — that is
# the file both launchers source. Never in settings.json, never tracked by git.

# Providers. All three are in use; a model whose provider has no key is still
# listed in settings.json and fails only when selected.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Telegram bridge (@llblab/pi-telegram). Needed only on the host that runs the
# bridge: exactly one machine may poll a given bot token, so leave this unset on
# any other host and the extension stays idle instead of fighting for updates.
TELEGRAM_BOT_TOKEN=

# gog (Google Workspace CLI). Required by the `gog-token-keepalive` cron job,
# which probes with `gog drive ls` and no --account; without these it fails with
# "missing --account". The file keyring backend also needs the passphrase in a
# non-interactive shell.
GOG_ACCOUNT=
GOG_KEYRING_PASSWORD=
