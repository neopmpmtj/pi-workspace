# ============================================================
# text-to-speech — environment configuration
# Copy this file to .env and fill in the keys you have.
# The .env file is git-ignored; never commit real keys.
# ============================================================

# OpenAI TTS (mid tier) — you likely already have this key in ~/.config/openai.env
OPENAI_API_KEY=

# ElevenLabs (top tier)
ELEVENLABS_API_KEY=

# Cartesia Sonic (mid+ tier) — free account at https://cartesia.ai
CARTESIA_API_KEY=

# --- Audio output ---
# Folder where generated audio files are saved (default: ~/Voice)
TTS_OUTPUT_DIR=~/Voice

# How many days to keep audio files before the cleanup job deletes them
TTS_RETENTION_DAYS=14
