# =============================================================================
# backup_tool environment configuration
# =============================================================================
# These keys live in ~/.pi/agent/.env (gitignored, sourced by the pi wrapper).
# Copy the values below into that file and fill in real secrets.
# Never commit real secrets.
#
# Other settings:
#   - Path / snapshot exclusions: src/backup_PC_tool/backup_config.json → key `blacklist` only.
#   - Force browser OAuth on a run: set shell env BACKUP_INTERACTIVE=1 (see main.py).
# =============================================================================

# -----------------------------------------------------------------------------
# Google authentication — choose ONE method below
# -----------------------------------------------------------------------------

# ── Option A: Service account (recommended for automation) ─────────────────
# Create a service account in Google Cloud Console → IAM & Admin → Service
# Accounts, download a JSON key, and set its path here. No browser OAuth,
# no token expiry — ideal for systemd/cron backups.
# When this file exists, OAuth settings (client id/secret/token) are ignored.

GOOGLE_SERVICE_ACCOUNT_KEY=/home/pmpmt/.pi/apps-scripts/backup_laptop_tool/service_account_key.json

# ── Option B: User OAuth (legacy — tokens expire after 7 days in Testing) ──
# Create a "Desktop app" OAuth client in Google Cloud Console → APIs & Services
# → Credentials. Use the client ID and secret here. First successful run stores
# refresh tokens in TOKEN_FILE (path below).

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# -----------------------------------------------------------------------------
# Google Drive layout (optional)
# -----------------------------------------------------------------------------
# Top-level Drive folder name created/used for uploads (created if missing).

GDRIVE_BACKUPS_FOLDER=backups

# If true, backups go under a subfolder named after this machine's hostname
# (inside GDRIVE_BACKUPS_FOLDER). If false, uploads go directly into that folder.
# Accepted: true/false, 1/0, yes/no, on (case-insensitive). Default: true.

USE_HOSTNAME_SUBFOLDER=true

# -----------------------------------------------------------------------------
# OAuth token storage (optional)
# -----------------------------------------------------------------------------
# Filename (under the package directory) for the saved user credentials JSON.
# Default: gdrive_token.json — add this file to .gitignore if you change the name.

TOKEN_FILE=gdrive_token.json

# -----------------------------------------------------------------------------
# Retention (optional)
# -----------------------------------------------------------------------------
# After each upload, oldest backups in the target folder may be deleted so at most
# this many files remain. Set to 0 to disable deletion. Default: 0.

RETENTION_COUNT=5
