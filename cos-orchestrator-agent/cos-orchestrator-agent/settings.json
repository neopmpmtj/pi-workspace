{
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find"
  ],
  "extensions": [
    "+extensions/auto-sync.ts",
    "+extensions/chat/index.ts",
    "+extensions/input-contains-email/index.ts",
    "+extensions/input-contains-path/index.ts",
    "+extensions/input-contains-url/index.ts",
    "+extensions/less-than-input-words/index.ts",
    "+extensions/pi-prompt-capture.ts",
    "+extensions/secret-scrubber.ts"
  ],
  "enabledModels": [
    "deepseek-flash",
    "deepseek-v4-pro",
    "gpt-6.1-sol",
    "gemini-3.8-flash",
    "gemini-3.7-flash"
  ],
  "theme": "dark",
  "lastChangelogVersion": "1.4.0",
  "packages": [
    "npm:@llblab/pi-telegram"
  ]
}
