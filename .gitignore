# ── Cron store & run history (machine-local state, never synced) ──
cron/jobs.json
cron/runs/

# ── Machine-local runtime dirs (regenerated, never synced) ──
agent/tmp/
agent/pi-web-access/

# Per-machine Telegram bot config (botToken ref + owner id) — never shared
agent/telegram.json

# Prompt-capture runtime state (rewritten every turn)
agent/state/prompt-capture/
# CoS agent state/ — runtime only (prompt-capture, per-turn churn). Nested, so the
# anchored rule above never matched it. NB: apps-scripts/**/text_to_speech/state/
# is Python source and must stay tracked.
agent/cos-orchestrator-agent/state/

# Per-machine model catalog cache, at any depth (agent dirs, sub-agents)
models-store.json

# Per-machine Telegram bot config, at any depth (agent dirs, sub-agents)
**/telegram.json
# Runtime state of bridge/sub-agents. state.json must stay 0600: the bridge
# refuses a world-readable runtime state, and a git checkout rewrote it 0664.
# (Anchored rules missed nested agent homes; use ** so any depth matches.)
**/tmp/pi-telegram/

z.old/

# Last archive-to-target run (one move, machine-local)
apps-scripts/archive-to-target-full-tree/archive-to-target-full-tree/archive-to-target-full-tree.last.json

# ── Siblings that keep their own repository ────────────────────────
# agent-lan-agent is a standalone git repo (own history, own .gitignore).
# Tracked here only until 2026-11-03; the nested repo would otherwise be
# picked up as an untracked directory by every status call.
agent-lan-agent/

# ── Decision-node runtime (verdicts and sweep logs, never synced) ──
decision-nodes/**/verdicts.jsonl
decision-nodes/**/logs/
decision-nodes/**/__pycache__/
# Message text kept 14 days for reviewing misclassifications (src/jev-classify.ts)
decision-nodes/review.jsonl
