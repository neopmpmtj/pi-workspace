#   git add -f agent/observability/
agent/observability/

# ── Skills are standalone repos (cloned individually from GitHub) ─────
agent/skills/partner-agent-export/
agent/skills/gog-workspace/
agent/skills/skill-creator/
agent/skills/video-finder/
agent/skills/yt-download/
agent/skills/pi-prompt-dump/
