# Copy this to ~/.pi/agent-tasks-agent/.env (repo root, beside the tasks-agent directory).
# pi-tasks-agent loads that file. Do not put keys in settings or source.

# All three providers are used by the same agent.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Dashboard (default 8791). DASHBOARD_ORIGIN must include the URL the browser uses.
DASHBOARD_PORT=8791
DASHBOARD_ORIGIN=http://127.0.0.1:8791

# `gog` in a non-interactive shell cannot prompt for either of these.
# GOG_ACCOUNT is the account every call uses when no --account is given.
# GOG_KEYRING_PASSWORD unlocks the `file` keyring backend where the refresh token lives.
GOG_ACCOUNT=
GOG_KEYRING_PASSWORD=
