[Unit]
Description=scheduler sweeper (observe-only decision node)
Documentation=file:/home/pmpmt/.pi/decision-nodes/scheduler/spec.md
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/pmpmt/.pi/decision-nodes/scheduler/bin/sweep.sh
StandardOutput=append:/home/pmpmt/.pi/decision-nodes/scheduler/logs/sweep.log
StandardError=append:/home/pmpmt/.pi/decision-nodes/scheduler/logs/sweep.log
TimeoutStartSec=600
