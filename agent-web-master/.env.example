# Copy this to ~/pi-agents-experts-grouped/web-master/.env (repo root, beside the web-master directory).
# pi-web-master loads that file. Do not put keys in settings or source.

# All three providers are used by the same agent.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Web search (pi-web-access). Optional: with neither set, the route falls through to
# keyless Exa MCP and then DuckDuckGo.
# BRAVE_API_KEY=
# PERPLEXITY_API_KEY=
